# -----------------------------------------------------------------------------
# Build directories
# -----------------------------------------------------------------------------
# Out-of-source build trees: cmake -S . -B build -G Ninja, build-debug, etc.
/build/
/build-*/
/cmake-build-*/
/out/

# -----------------------------------------------------------------------------
# CMake / Ninja
# -----------------------------------------------------------------------------
# CMakePresets.json is meant to be committed; the user-local one is not
CMakeUserPresets.json

# Qt Creator per-user project settings (also covers versioned *.user.<ver>)
CMakeLists.txt.user
CMakeLists.txt.user.*

# clangd / language-server helpers
/compile_commands.json
/.cache/
.qtc_clangd/

# Generated by AUTOMOC / AUTOUIC / AUTORCC
*_autogen/

# Ninja bookkeeping
build.ninja
rules.ninja
.ninja_deps
.ninja_log

# Safety net for an accidental in-source configure
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
/_deps/
/Testing/

# -----------------------------------------------------------------------------
# Compiled objects, libraries and binaries
# -----------------------------------------------------------------------------
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.exe
*.dll
*.dylib
*.so
*.so.*
*.so.debug
*.pdb
*.idb
*.ib_pdb_index

# Core dumps (anchored: a bare "core" would also hide any source dir named core)
/core
/core.[0-9]*

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log

# -----------------------------------------------------------------------------
# IDE / editor files
# -----------------------------------------------------------------------------
# Qt Creator
.qtcreator/
*.autosave

# Visual Studio
.vs/
*.sln
*.suo
*.ncb
*.user
*.vcproj
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# JetBrains / VS Code
.idea/
.vscode/

# Eclipse
.project
.cproject
.settings/

# Editor temporary and backup files
*~
*.bak
*.swp
*.swo

# Failed patches
*.orig
*.rej

# -----------------------------------------------------------------------------
# OS-specific files
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
desktop.ini
# macOS
.DS_Store

# -----------------------------------------------------------------------------
# AI agent tooling (Graft + OpenCode)
# -----------------------------------------------------------------------------
# Graft's generated code graph: a local, regenerable cache (like node_modules).
# The wiring `graft init` writes (AGENTS.md, MCP config, ...) IS meant to be
# committed, so it is intentionally not ignored here.
/graft/

# Dependencies OpenCode installs for project-local plugins/tools
.opencode/node_modules/
